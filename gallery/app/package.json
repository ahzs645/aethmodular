{
  "name": "aeth-graph-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + D3 gallery over the aethmodular notebook figure estate",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-graphic-walker.mjs && node scripts/build-chart-index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/lib/*.test.mjs' 'src/charts/**/*.test.mjs' 'src/sections/**/*.test.mjs'",
    "check:walker": "node scripts/check-graphic-walker.mjs",
    "test:walker": "node --test src/lib/chartBuilder.test.mjs",
    "test:walker:browser": "node scripts/check-chart-builder.mjs",
    "index:charts": "node scripts/build-chart-index.mjs",
    "postinstall": "node scripts/ensure-toolkit.mjs",
    "toolkit": "node scripts/ensure-toolkit.mjs --force"
  },
  "dependencies": {
    "@firstform/json-url": "^4.2.0",
    "@kanaries/graphic-walker": "0.4.82",
    "@pgmaps/geo-toolkit": "file:../packages/geo-toolkit",
    "@react-querybuilder/core": "8.24.3",
    "buffer": "^6.0.3",
    "d3": "^7.9.0",
    "d3-hexbin": "^0.2.2",
    "d3-sankey": "^0.12.3",
    "json-logic-engine": "5.0.7",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-querybuilder": "8.24.3",
    "styled-components": "5.3.11",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/d3": "^7.4.3",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-sankey": "^0.12.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "overrides": {
    "@react-querybuilder/core": "8.24.3"
  }
}
