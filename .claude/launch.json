{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "calibration-explorer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec \"$HOME/anaconda3/bin/python\" calibration_explorer/app.py"
      ],
      "port": 5058,
      "autoPort": true
    },
    {
      "name": "gallery",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--no-open"
      ],
      "cwd": "gallery/app",
      "port": 5178
    },
    {
      "name": "gallery-share",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "-d",
        "gallery/share/dist"
      ],
      "port": 5180
    },
    {
      "name": "gallery-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5181",
        "-d",
        "gallery/share/pages-dist"
      ],
      "port": 5181
    },
    {
      "name": "gallery-dev-b",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--no-open",
        "--port",
        "5183",
        "--strictPort"
      ],
      "cwd": "gallery/app",
      "port": 5183
    }
  ]
}
