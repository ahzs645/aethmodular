{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "calibration-explorer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec \"$HOME/anaconda3/bin/python\" calibration_explorer/app.py"
      ],
      "port": 5058,
      "autoPort": true
