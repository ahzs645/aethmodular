    "FilterBased_ChemSpecPM25_USPA.csv",
    "FilterBased_ChemSpecPM25_ETAD.csv"
  ],
  "outputDirFromRepo": "research/ftir_hips_chem/output/tables/zoer_sources",
  "format": "parquet",
  "compression": "zstd",
  "validation": "read-back-frame-equality"
}
