{
  "schemaVersion": 1,
  "id": "aeth.four-site-chemspec-parquet",
  "version": 1,
  "description": "Preserve the four SPARTAN public ChemSpec PM2.5 exports as queryable Parquet, omitting only their three file-comment lines.",
